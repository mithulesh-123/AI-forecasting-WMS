// WMS AI Forecasting - Prisma schema (PostgreSQL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  VIEWER
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum DispatchStatus {
  PENDING
  PROCESSING
  READY
  DISPATCHED
  CANCELLED
}

enum ForecastHorizon {
  D7
  D14
  D30
}

enum StockoutRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  dispatches      Dispatch[]      @relation("DispatchCreatedBy")
  notifications   Notification[]

  @@index([role])
  @@map("users")
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  location    String
  capacity    Int
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories            Inventory[]
  stockMovements         StockMovement[]      @relation("MovementWarehouse")
  transferMovements      StockMovement[]      @relation("MovementDestination")
  dispatches             Dispatch[]

  @@index([isActive])
  @@map("warehouses")
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  description     String?
  category        String
  unit            String   @default("pcs")
  price           Decimal  @db.Decimal(12, 2)
  reorderLevel    Int      @default(10)
  reorderQuantity Int      @default(50)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventories   Inventory[]
  stockMovements StockMovement[]
  dispatchItems DispatchItem[]
  forecasts     Forecast[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  warehouseId      String
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory")
}

model StockMovement {
  id                     String        @id @default(cuid())
  productId              String
  warehouseId            String
  destinationWarehouseId String?
  type                   MovementType
  /// Signed effect on source warehouse stock (positive adds, negative removes)
  quantityDelta          Int
  /// Absolute units for reporting purposes
  quantity               Int
  reason                 String?
  reference              String?
  userId                 String
  createdAt              DateTime      @default(now())

  product              Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse            Warehouse @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse? @relation("MovementDestination", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@map("stock_movements")
}

model Dispatch {
  id           String         @id @default(cuid())
  number       String         @unique
  customerName String
  customerRef  String?
  status       DispatchStatus @default(PENDING)
  warehouseId  String
  notes        String?
  requestedAt  DateTime       @default(now())
  dispatchedAt DateTime?
  cancelledAt  DateTime?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdByUser User      @relation("DispatchCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items     DispatchItem[]

  @@index([status, requestedAt])
  @@index([warehouseId])
  @@index([createdBy])
  @@map("dispatches")
}

model DispatchItem {
  id         String @id @default(cuid())
  dispatchId String
  productId  String
  quantity   Int
  createdAt  DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@index([productId])
  @@map("dispatch_items")
}

model Forecast {
  id                    String          @id @default(cuid())
  productId             String
  horizon               ForecastHorizon
  predictedDemand       Float
  dailyAvgDemand        Float
  confidence            Float
  stockoutRisk          StockoutRisk
  recommendedReorderQty Int
  method                String
  history               Json
  predictions           Json
  generatedAt           DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, horizon])
  @@index([stockoutRisk])
  @@map("forecasts")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String?
  title      String
  message    String
  type       NotificationType @default(INFO)
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
