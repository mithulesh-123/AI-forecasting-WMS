# ---------------------------------------------------------------------------
# WMS AI Forecasting - Environment Variables
# Copy to .env (local) or configure in Vercel Project Settings.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (pooled, e.g. Neon/Supabase pgBouncer)
DATABASE_URL=

# Direct (non-pooled) connection - required by some pooled providers for migrations (e.g. Neon)
DIRECT_URL=

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=

# OPTIONAL - external AI forecasting provider. The statistical forecasting
# engine works fully without it; if present it will be preferred.
AI_API_KEY=
AI_FORECAST_URL=
